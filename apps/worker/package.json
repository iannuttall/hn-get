{
  "name": "@hn-get/worker",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "clean": "rm -rf dist .wrangler",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "dev": "wrangler dev --local --port 8787",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types": "wrangler types src/worker-configuration.d.ts",
    "types:check": "wrangler types src/worker-configuration.d.ts --check"
  },
  "dependencies": {
    "@hn-get/core": "workspace:*",
    "@hn-get/mcp": "workspace:*",
    "@hn-get/rss": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "hono": "^4.13.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hn-get/docs": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260708.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.110.0"
  }
}
