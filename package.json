{
  "name": "hn-get-monorepo",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm lint",
    "clean": "turbo run clean",
    "dev": "pnpm --filter @hn-get/worker dev",
    "dev:cli": "pnpm --filter hn-get dev",
    "dev:docs": "pnpm --filter @hn-get/docs dev",
    "lint": "biome check . && turbo run lint",
    "lint:fix": "biome check . --write",
    "pack:dry-run": "pnpm --filter hn-get pack --dry-run",
    "security:audit": "pnpm audit --audit-level moderate",
    "security:check": "pnpm run security:audit && pnpm run security:secrets",
    "security:secrets": "node scripts/security-secrets.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "types": "pnpm --filter @hn-get/worker types",
    "types:check": "pnpm --filter @hn-get/worker types:check",
    "worker:deploy": "pnpm --filter @hn-get/docs build && pnpm --filter @hn-get/worker run deploy",
    "worker:deploy:dry-run": "pnpm --filter @hn-get/worker deploy:dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^24.0.0",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3"
  }
}
